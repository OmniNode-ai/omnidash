{
  "clientId": "omnidash",
  "name": "OmniNode Dashboard",
  "description": "omnidash web dashboard client (OMN-13824). Source-controlled config; apply via kcadm per https://github.com/OmniNode-ai/knowledge-base-internal/blob/main/runbooks/omnidash-keycloak-realm-config.md — never hand-edit the live realm without updating this file.",
  "protocol": "openid-connect",
  "enabled": true,
  "publicClient": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "frontchannelLogout": true,
  "rootUrl": "https://dev.dash.omninode.ai",
  "baseUrl": "/",
  "redirectUris": [
    "https://dev.dash.omninode.ai/*"
  ],
  "webOrigins": [
    "https://dev.dash.omninode.ai"
  ],
  "attributes": {
    "post.logout.redirect.uris": "https://dev.dash.omninode.ai/*",
    "pkce.code.challenge.method": "S256"
  },
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "roles",
    "email",
    "tenant"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ],
  "protocolMappers": [
    {
      "name": "onex-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "onex-api",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    },
    {
      "name": "tenant-slug",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "tenant_slug",
        "claim.name": "tenant_slug",
        "jsonType.label": "String",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false"
      }
    }
  ]
}
